# Claude Monitor account list
#
# Format for bulk import (and for the auto-loaded master lists at
# ~/.claude-monitor/accounts.env / accounts.local.env):
# one ACCOUNT_EMAIL_N / ACCOUNT_KEY_N pair per account, tokens from
# `claude setup-token` (sk-ant-oat01-..., long-lived ~1 year).
#
# Keep real token files chmod 600 — they contain live credentials.

ACCOUNT_EMAIL_1=you@example.com
ACCOUNT_KEY_1=sk-ant-oat01-...

ACCOUNT_EMAIL_2=agent@example.com
ACCOUNT_KEY_2=sk-ant-oat01-...
